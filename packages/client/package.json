{
  "name": "@lore/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:slot": "vite build --mode slot",
    "dev": "vite --mode development",
    "dev:slot": "vite --mode slot",
    "lint": "bun run lint:oxlint && bun run lint:biome",
    "lint:biome": "biome check --write",
    "lint:ci": "bun run lint:ci:oxlint && bun run lint:ci:biome",
    "lint:ci:biome": "biome ci",
    "lint:ci:oxlint": "oxlint -c ./.oxlintrc.json --import-plugin",
    "lint:oxlint": "oxlint -c ./.oxlintrc.json --import-plugin --fix",
    "preview": "vite preview --port 8080",
    "start": "serve -s /dist --port 8080",
    "cert:install": "cd ssl && bunx mkcert create-ca && bunx mkcert create-cert localhost"
  },
  "dependencies": {
    "@cartridge/controller": "^0.10.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@dojoengine/core": "1.8.0",
    "@dojoengine/sdk": "1.8.0",
    "@dojoengine/torii-wasm": "1.8.0",
    "@dojoengine/utils": "1.8.0",
    "@lore/contracts": "workspace:*",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@scaleway/random-name": "^5.1.1",
    "@unhead/react": "^2.0.0-beta.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dnd-kit-tree": "^1.0.22",
    "envalid": "^8.0.0",
    "immer": "^10.1.1",
    "json-bigint": "^1.0.0",
    "lucide-react": "^0.487.0",
    "mkcert": "^3.2.0",
    "pure-rand": "^7.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.3",
    "starknet": "^8.5.4",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.3",
    "tw-animate-css": "^1.2.5",
    "wouter": "^3.6.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0-beta.1",
    "@tailwindcss/vite": "^4.1.3",
    "@types/json-bigint": "^1.0.4",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.8",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitejs/plugin-react": "^4.7.0",
    "ansicolor": "^2.0.3",
    "bun": "^1.2.2",
    "bun-types": "^1.2.2",
    "oxlint": "^0.16.5",
    "typescript": "^5.7.3",
    "vite": "^7.1.6",
    "vite-plugin-mkcert": "^1.17.8",
    "vite-plugin-oxlint": "^1.3.1",
    "vite-plugin-top-level-await": "^1.5.0",
    "vite-plugin-wasm": "^3.4.1"
  },
  "engines": {
    "bun": "^1.2.3"
  },
  "trustedDependencies": [
    "oxlint",
    "vite",
    "bun"
  ]
}
