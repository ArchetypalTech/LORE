# Copy to .env and fill in. Never commit .env.
# All VITE_* values are inlined into the built JS bundle, so they are visible to
# anyone who loads the site — use them for config, not secrets.

# Starknet profile: dev | sepolia | mainnet (defaults to sepolia)
VITE_PROFILE=sepolia

# /walkthrough PIN gate (client-side only — a casual gate, not security)
# SHA-256 hex of the PIN:  printf <pin> | shasum -a 256
# Unset = the walkthrough can't be unlocked.
VITE_WALKTHROUGH_PIN_HASH=
# URL of the video embedded once unlocked (e.g. a Google Drive /preview link)
VITE_WALKTHROUGH_EMBED=
